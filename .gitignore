# ============================================================
# MediLink — .gitignore
# Healthcare prototype (Flask + Solidity + Avalanche Fuji)
# ============================================================

# ------------------------------------------------------------
# 1. Secrets & environment
# Never commit credentials, private keys, or RPC URLs with auth
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# ------------------------------------------------------------
# 2. Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/

# Testing / coverage / type checkers
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# ------------------------------------------------------------
# 3. IDE & operating system
# ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ------------------------------------------------------------
# 4. Logs, temp files, local databases
# ------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.temp
*.sqlite
*.sqlite3
*.db
instance/

# ------------------------------------------------------------
# 5. Uploaded medical documents & private data
# Keep source and demo assets; ignore real patient content
# ------------------------------------------------------------
uploads/
ocr_output/
medical_data/
patient_docs/
private/

# ------------------------------------------------------------
# 6. Solidity / blockchain tooling (if used)
# Keep contracts/Consent.sol trackable
# ------------------------------------------------------------
cache/
artifacts/
typechain/
typechain-types/
coverage/
coverage.json
node_modules/

# Hardhat / Foundry local config that may hold keys
hardhat.config.local.js
foundry.toml.local

# ------------------------------------------------------------
# 7. Optional local overrides (safe to ignore)
# ------------------------------------------------------------
*.local
local_settings.py