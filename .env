# Required
SECRET_KEY=change-me-to-a-long-random-string

# Optional demo passwords (defaults shown)
DEMO_PATIENT_PASSWORD=demo-patient
DEMO_STAFF_PASSWORD=demo-staff

# Session / server
SESSION_COOKIE_SECURE=false
FLASK_DEBUG=false
PORT=5000
UPLOAD_FOLDER=uploads

# Blockchain (leave empty until ready)
AVALANCHE_FUJI_RPC=
CONSENT_CONTRACT_ADDRESS=0x4C2E26427B4BC5564AEEa12Ef6ed1968267fF9EC
# Never put a private key in .env that is committed to git
AVALANCHE_CHAIN_ID=43113
AVALANCHE_NETWORK=Avalanche Fuji Testnet
